# Supabase — proyecto propio de tradtracker (hermano del de TradTube)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# TradTube — los vídeos de la lista de ensayo (issue #37).
# Son claves PÚBLICAS: las mismas que viaja en el bundle de TradTube, y aquí solo
# se lee su API con la clave anónima. NO pongas aquí la service_role de TradTube.
# Opcionales a propósito: sin ellas la lista de ensayo funciona, sin vídeos.
VITE_TRADTUBE_URL=https://your-tradtube-project.supabase.co
VITE_TRADTUBE_ANON=your-tradtube-anon-key

# OJO: este fichero se expone al navegador.
# La service_role / secret NO va aquí ni en ningún .env del front.
